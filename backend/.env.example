# Copy this file to .env and fill in your values.
# The defaults here match the docker-compose.yml service definitions exactly.

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://docsim:docsim_secret@localhost:5432/docsim

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Algorithm parameters ---
# n = b * r MUST hold.  Changing b or r invalidates the LSH index;
# run POST /analysis/rebuild-index after any change.
MINHASH_N=100
SHINGLE_K=5
LSH_B=20
LSH_R=5

# --- Similarity ---
SIMILARITY_THRESHOLD=0.7

# --- App ---
# Set to "production" in prod.  In "development" the API returns full
# tracebacks in error responses.
APP_ENV=development
